{
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {
    "editor.fontSize": 12,
    "workbench.tree.renderIndentGuides": "always",
    "files.enableTrash": false,
    "git.confirmSync": false,
    "workbench.activityBar.location": "top",
    "git.ignoreLimitWarning": true,
    "locale": "en-US",
    "workbench.editor.wrapTabs": true,
    "workbench.tree.indent": 12,
    "explorer.confirmDelete": false,
    "explorer.incrementalNaming": "smart",
    "flutter-coverage.coverageFilePaths": [
      "noiselabyrinth_gui/coverage",
      "noiselabyrinth_core/coverage",
      "noiselabyrinth_test_cli/coverage",
    ],
    "errorLens.fontSize": "-2px",
    "errorLens.fontStyleItalic": true,
    "errorLens.fontWeight": "300",
    "dart.lineLength": 120,
    "files.exclude": {
      "**/.dart_tool": true,
      "**/*.iml": true,
      "**/*.lock": true,
      "**/*plugins-dependencies": true,
      "**/build": true,
      "**/coverage": true,
    },
    "search.exclude": {
      "**/.dart_tool": true,
      "**/*.iml": true,
      "**/*.lock": true,
      "**/*plugins-dependencies": true,
      "**/build": true,
      "**/coverage": true,
    },
  },
}
